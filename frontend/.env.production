# Production bundle (Vercel, or any `npm run build`).
#
# This is the committed fallback so a static build is never left pointing at
# localhost. Vercel Project Settings → Environment Variables (VITE_API_URL /
# VITE_USE_MOCK) OVERRIDE these values when they are set there.
#
# Vite inlines VITE_* at build time — changing this file needs a redeploy.
VITE_API_URL=https://lenderscrm-api.onrender.com
VITE_USE_MOCK=
