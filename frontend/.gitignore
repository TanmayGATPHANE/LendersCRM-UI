# AMS frontend — build output, dependencies, and machine-local state are
# never committed; only src/ + config travel with the repo.

node_modules/

# build output (inline comments are NOT valid .gitignore syntax — they
# quietly broke these two patterns before, which is how dist/ got committed)
dist/
*.tsbuildinfo

# local env files (may hold VITE_API_URL or tokens)
.env.local
.env.*.local

# editors / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
.vercel
.env*.local
