# Copy to .env.local (gitignored) for machine-specific overrides.
# .env.local wins over .env.development / .env.production.
#
# VITE_API_URL  base URL of the .NET API (no trailing slash)
# VITE_USE_MOCK 1 = in-memory demo data, no backend needed; unset/0 = real API
VITE_API_URL=http://localhost:5246
VITE_USE_MOCK=
