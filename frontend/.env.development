# Local development (`npm run dev`, Vite mode "development").
# Committed so a fresh clone knows exactly which API it talks to.
# Override per machine in .env.local (gitignored) — never edit this file for
# personal settings.
VITE_API_URL=http://localhost:5246

# Uncomment to run the whole UI on the in-memory demo data (no backend):
# VITE_USE_MOCK=1
